# Vyom ERP Environment Configuration

# SMTP / Email Server Settings
# Configure these with your email provider details to receive actual handover notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false # Set to true if using SSL port 465, false for TLS port 587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Security
# Required. Long random string used to sign login tokens (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# Only used when the users table is empty: creates the first Admin with this password.
# Leave unset after the first Admin exists.
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# Extra browser origins allowed to call the API cross-origin (comma-separated).
# Not needed when the app is served through nginx or the Vite proxy (same origin).
ALLOWED_ORIGINS=
