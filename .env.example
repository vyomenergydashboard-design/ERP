# Vyom ERP Environment Configuration

# SMTP / Email Server Settings
# Configure these with your email provider details to receive actual handover notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false # Set to true if using SSL port 465, false for TLS port 587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
